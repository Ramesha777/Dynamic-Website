rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // By default, deny all reads and writes.
    // We will grant access on a per-collection basis below.

    // Helper function to check if a user is an authenticated admin.
    // In this setup, any logged-in user is considered an admin.
    function isAdmin() {
      return request.auth != null;
    }

    // Reservations: Public can create, but only admins can read/update/delete.
    match /reservations/{reservationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Events & Settings: Public can read, but only admins can write/edit/delete.
    match /(events|settings)/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}