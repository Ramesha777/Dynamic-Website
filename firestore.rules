rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // By default, deny all reads and writes.
    // We will grant access on a per-collection basis below.

    // Helper function to check if a user is logged in.
    // Since only admins have login credentials in your app, this is sufficient.
    function isAdmin() {
      return request.auth != null;
    }

    // Reservations: Public can create, but only admins can read/update/delete.
    match /reservations/{reservationId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Events: Public can read, but only admins can write/edit/delete.
    match /events/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Settings: Public can read, but only admins can write/edit/delete.
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Menu items: Public can read the full menu; only admins can import/edit/delete.
    match /menuItems/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}